    {
      "cell_type": "code",
      "source": [
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import seaborn as sns\n",
        "\n",
        "def extrair_taxa_excel(caminho_arquivo, termo_busca, num_colunas):\n",
        "    \"\"\"Localiza a seção da variável e a linha específica do Brasil no arquivo Excel.\"\"\"\n",
        "    df_excel = pd.read_excel(caminho_arquivo, header=None)\n",
        "\n",
        "    linha_inicio = None\n",
        "    for idx, row in df_excel.iterrows():\n",
        "        linha_str = \" \".join(row.astype(str).tolist())\n",
        "        if termo_busca in linha_str:\n",
        "            linha_inicio = idx\n",
        "            break\n",
        "\n",
        "    if linha_inicio is None:\n",
        "        linha_inicio = 0\n",
        "\n",
        "    # Busca dinamicamente a linha contendo o \"Brasil\" abaixo da linha de início\n",
        "    linha_brasil = None\n",
        "    for idx in range(linha_inicio, len(df_excel)):\n",
        "        row_vals = df_excel.iloc[idx].astype(str).tolist()\n",
        "        if \"Brasil\" in row_vals or any(\"Brasil\" in str(val) for val in row_vals):\n",
        "            linha_brasil = idx\n",
        "            break\n",
        "\n",
        "    if linha_brasil is None:\n",
        "        # Caso falhe a busca dinâmica, recorre à linha presumida (+4)\n",
        "        linha_brasil = linha_inicio + 4\n",
        "\n",
        "    dados_brasil = df_excel.iloc[linha_brasil].tolist()\n",
        "\n",
        "    # Filtra e retorna apenas os valores numéricos das colunas de dados\n",
        "    valores = []\n",
        "    for x in dados_brasil[1:num_colunas+1]:\n",
        "        try:\n",
        "            valores.append(float(x))\n",
        "        except:\n",
        "            valores.append(0.0)\n",
        "    return valores\n",
        "\n",
        "# ==============================================================================\n",
        "# 1. CARREGAMENTO E EXTRAÇÃO DOS DADOS (1º e 2º Trimestres de 2026)\n",
        "# ==============================================================================\n",
        "arq_sexo = \"/content/Tabela 4093 SIDRA IBGE.xlsx\"\n",
        "arq_idade = \"/content/Tabela 4094 SIDRA IBGE.xlsx\"\n",
        "\n",
        "# TABELA 4093: Extraindo dados de sexo\n",
        "dados_sexo = extrair_taxa_excel(\n",
        "    arq_sexo, \"Pessoas de 14 anos ou mais de idade\", 18\n",
        ")\n",
        "\n",
        "# Mapeando os trimestres reais baseados na estrutura das colunas do Excel\n",
        "taxa_total_1t26 = dados_sexo[12]   # Total 1T26\n",
        "taxa_total_2t26 = dados_sexo[15]   # Total 2T26\n",
        "\n",
        "taxa_homem_1t26 = dados_sexo[13]   # Homens 1T26\n",
        "taxa_homem_2t26 = dados_sexo[16]   # Homens 2T26\n",
        "\n",
        "taxa_mulher_1t26 = dados_sexo[14]  # Mulheres 1T26\n",
        "taxa_mulher_2t26 = dados_sexo[17]  # Mulheres 2T26\n",
        "\n",
        "# TABELA 4094: Extraindo dados de idade\n",
        "dados_idade = extrair_taxa_excel(\n",
        "    arq_idade, \"Pessoas de 14 anos ou mais de idade\", 6\n",
        ")\n",
        "taxa_idade_1t26 = dados_idade[4]   # Grupo Idade 1T26\n",
        "taxa_idade_2t26 = dados_idade[5]   # Grupo Idade 2T26\n",
        "\n",
        "# ==============================================================================\n",
        "# 2. CONFIGURAÇÃO VISUAL E ESTRUTURAÇÃO PLOT\n",
        "# ==============================================================================\n",
        "sns.set_theme(style=\"whitegrid\")\n",
        "fig, axes = plt.subplots(1, 3, figsize=(18, 6), sharey=True)\n",
        "fig.suptitle(\n",
        "    \"Análise Detalhada da Força de Trabalho no Brasil (1º vs 2º Trimestre de 2026)\",\n",
        "    fontsize=18,\n",
        "    fontweight=\"bold\",\n",
        "    y=1.05,\n",
        ")\n",
        "\n",
        "trimestres = [\"1º Trimestre 2026\", \"2º Trimestre 2026\"]\n",
        "x = np.arange(len(trimestres))\n",
        "largura = 0.35\n",
        "\n",
        "def adicionar_rotulos(ax, barras):\n",
        "    for barra in barras:\n",
        "        altura = barra.get_height()\n",
        "        if altura > 0:\n",
        "            ax.annotate(\n",
        "                f\"{altura:,.0f}\",\n",
        "                xy=(barra.get_x() + barra.get_width() / 2, altura),\n",
        "                xytext=(0, 3),\n",
        "                textcoords=\"offset points\",\n",
        "                ha=\"center\",\n",
        "                va=\"bottom\",\n",
        "                fontsize=11,\n",
        "                fontweight=\"bold\",\n",
        "            )\n",
        "\n",
        "# --- GRÁFICO 1: POPULAÇÃO TOTAL ---\n",
        "b_tot = axes[0].bar(\n",
        "    x, [taxa_total_1t26, taxa_total_2t26], largura, color=\"#4a90e2\"\n",
        ")\n",
        "axes[0].set_title(\"Força de Trabalho Total (Milhares)\", fontsize=14, fontweight=\"bold\")\n",
        "axes[0].set_xticks(x)\n",
        "axes[0].set_xticklabels(trimestres, fontsize=12)\n",
        "axes[0].set_ylabel(\"Pessoas (Milhares)\", fontsize=12)\n",
        "adicionar_rotulos(axes[0], b_tot)\n",
        "\n",
        "# --- GRÁFICO 2: POR GÊNERO ---\n",
        "b_homem = axes[1].bar(\n",
        "    x - largura / 2,\n",
        "    [taxa_homem_1t26, taxa_homem_2t26],\n",
        "    largura,\n",
        "    label=\"Homens\",\n",
        "    color=\"#2c3e50\",\n",
        ")\n",
        "b_mulher = axes[1].bar(\n",
        "    x + largura / 2,\n",
        "    [taxa_mulher_1t26, taxa_mulher_2t26],\n",
        "    largura,\n",
        "    label=\"Mulheres\",\n",
        "    color=\"#e74c3c\",\n",
        ")\n",
        "axes[1].set_title(\"Por Gênero (Milhares)\", fontsize=14, fontweight=\"bold\")\n",
        "axes[1].set_xticks(x)\n",
        "axes[1].set_xticklabels(trimestres, fontsize=12)\n",
        "axes[1].legend(loc=\"upper right\")\n",
        "adicionar_rotulos(axes[1], b_homem)\n",
        "adicionar_rotulos(axes[1], b_mulher)\n",
        "\n",
        "# --- GRÁFICO 3: POR IDADE ---\n",
        "b_id = axes[2].bar(\n",
        "    x, [taxa_idade_1t26, taxa_idade_2t26], largura, color=\"#1abc9c\"\n",
        ")\n",
        "axes[2].set_title(\"Por Faixa Etária Referência (Milhares)\", fontsize=14, fontweight=\"bold\")\n",
        "axes[2].set_xticks(x)\n",
        "axes[2].set_xticklabels(trimestres, fontsize=12)\n",
        "adicionar_rotulos(axes[2], b_id)\n",
        "\n",
        "# Ajustes finais de layout\n",
        "limite_y = max(taxa_mulher_1t26, taxa_total_1t26, taxa_idade_1t26, 100.0) * 1.15\n",
        "axes[0].set_ylim(0, limite_y)\n",
        "sns.despine(left=True, bottom=True)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
