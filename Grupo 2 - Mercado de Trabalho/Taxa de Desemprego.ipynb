      "source": [
        "# Calculando as variações percentuais entre o 1º e o 2º Trimestre de 2026\n",
        "var_total = ((taxa_total_2t26 - taxa_total_1t26) / taxa_total_1t26) * 100\n",
        "var_homem = ((taxa_homem_2t26 - taxa_homem_1t26) / taxa_homem_1t26) * 100\n",
        "var_mulher = ((taxa_mulher_2t26 - taxa_mulher_1t26) / taxa_mulher_1t26) * 100\n",
        "var_idade = ((taxa_idade_2t26 - taxa_idade_1t26) / taxa_idade_1t26) * 100\n",
        "\n",
        "# Exibindo os resultados de forma formatada\n",
        "print(\"Variação Percentual (1º Trimestre 2026 vs 2º Trimestre 2026):\\n\")\n",
        "print(f\"Força de Trabalho Total:  {var_total:+.2f}%\")\n",
        "print(f\"Homens:                   {var_homem:+.2f}%\")\n",
        "print(f\"Mulheres:                 {var_mulher:+.2f}%\")\n",
        "print(f\"Faixa Etária Referência:  {var_idade:+.2f}%\")"
      ],
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
