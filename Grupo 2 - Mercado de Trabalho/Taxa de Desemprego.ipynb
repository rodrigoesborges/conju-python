        "import pandas as pd\n",
        "\n",
        "# Caminho para o arquivo carregado no ambiente do Colab\n",
        "caminho_arquivo = '/content/Tabela 4093 SIDRA IBGE.xlsx'\n",
        "\n",
        "# Carregando o arquivo Excel\n",
        "df_tabela_4093 = pd.read_excel(caminho_arquivo)\n",
        "\n",
        "# Criamos uma cópia temporária para exibição limpando os valores nulos nos dados\n",
        "df_visualizacao = df_tabela_4093.head(10).copy()\n",
        "df_visualizacao = df_visualizacao.fillna(\"\")\n",
        "\n",
        "# Solução para evitar colunas com nomes exatamente iguais:\n",
        "# Usamos espaços de tamanhos crescentes para que cada coluna pareça vazia, mas seja única para o Styler!\n",
        "colunas_unicas = []\n",
        "espacos = \" \"\n",
        "for col in df_visualizacao.columns:\n",
        "    if \"Unnamed:\" in str(col):\n",
        "        colunas_unicas.append(espacos)\n",
        "        espacos += \" \"  # Adiciona mais um espaço para torná-la única\n",
        "    else:\n",
        "        colunas_unicas.append(col)\n",
        "\n",
        "df_visualizacao.columns = colunas_unicas\n",
        "\n",
        "# Criando uma exibição formatada e elegante com Pandas Styler\n",
        "estilo_tabela = (\n",
        "    df_visualizacao\n",
        "    .style\n",
        "    .set_properties(**{\n",
        "        'background-color': '#f9f9f9',\n",
        "        'border-color': '#dddddd',\n",
        "        'border-style': 'solid',\n",
        "        'border-width': '1px',\n",
        "        'color': '#333333',\n",
        "        'font-family': 'DejaVu Sans, sans-serif',\n",
        "        'font-size': '12px'\n",
        "    })\n",
        "    .set_table_styles([\n",
        "        {'selector': 'th', 'props': [\n",
        "            ('background-color', '#2c3e50'),\n",
        "            ('color', 'white'),\n",
        "            ('font-weight', 'bold'),\n",
        "            ('text-align', 'center'),\n",
        "            ('font-size', '13px')\n",
        "        ]},\n",
        "        {'selector': 'tr:nth-child(even)', 'props': [\n",
        "            ('background-color', '#f2f4f4')\n",
        "        ]}\n",
        "    ])\n",
        "    .hide(axis='index')\n",
        ")\n",
        "\n",
        "# Exibindo a tabela estilizada de forma limpa\n",
        "display(estilo_tabela)"
