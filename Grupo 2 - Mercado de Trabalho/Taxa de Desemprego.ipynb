    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 429
        },
        "id": "91267d32",
        "outputId": "71c00cb9-468d-44a4-87bf-1cdc3355ad08"
      },
      "source": [
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import numpy as np\n",
        "\n",
        "# Carregando os dados brutos da Tabela 4094 para processamento dinâmico\n",
        "df_raw_4094 = pd.read_excel('/content/Tabela 4094 SIDRA IBGE.xlsx', header=None)\n",
        "\n",
        "# Identificar as colunas de trimestre (linha 3) e grupos de idade (linha 4)\n",
        "trimestres_cabecalho = df_raw_4094.iloc[3].ffill().tolist()[1:]\n",
        "grupos_idade_cabecalho = df_raw_4094.iloc[4].tolist()[1:]\n",
        "\n",
        "# Capturando a linha de dados do Brasil\n",
        "linha_brasil_idx = df_raw_4094[df_raw_4094[0] == 'Brasil'].index[0]\n",
        "valores_brasil = df_raw_4094.iloc[linha_brasil_idx].tolist()[1:]\n",
        "\n",
        "# Criando um DataFrame estruturado para os dados de idade\n",
        "dados_processados = []\n",
        "for trim, grupo, valor in zip(trimestres_cabecalho, grupos_idade_cabecalho, valores_brasil):\n",
        "    try:\n",
        "        valor_num = float(valor)\n",
        "    except:\n",
        "        valor_num = 0.0\n",
        "    dados_processados.append({\n",
        "        'Trimestre': trim,\n",
        "        'Grupo de Idade': grupo,\n",
        "        'Pessoas (Milhares)': valor_num\n",
        "    })\n",
        "\n",
        "df_analise_4094 = pd.DataFrame(dados_processados)\n",
        "\n",
        "# Configurando o estilo visual\n",
        "sns.set_theme(style=\"whitegrid\")\n",
        "plt.figure(figsize=(10, 5))\n",
        "\n",
        "# Plotando a evolução temporal da Tabela 4094\n",
        "plot_data = df_analise_4094[df_analise_4094['Grupo de Idade'] == 'Total']\n",
        "sns.lineplot(data=plot_data, x='Trimestre', y='Pessoas (Milhares)', marker='o', linewidth=3, color='#16a085')\n",
        "\n",
        "plt.title(\"Evolução Temporal da População de Referência (Tabela 4094 - Total)\", fontsize=14, fontweight='bold', pad=15)\n",
        "plt.xlabel(\"Trimestres\", fontsize=12)\n",
        "plt.ylabel(\"Milhares de Pessoas\", fontsize=12)\n",
        "plt.xticks(rotation=15)\n",
        "\n",
        "# Adicionando rótulos aos pontos do gráfico\n",
        "for x_idx, y_val in enumerate(plot_data['Pessoas (Milhares)']):\n",
        "    plt.annotate(f\"{y_val:,.0f}\", (x_idx, y_val), textcoords=\"offset points\", xytext=(0,10), ha='center', fontweight='bold', color='#117a65')\n",
